# ==============================================================================
# SignalScope AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.

# Server Configuration
PORT=3001
NODE_ENV=development

# CoinMarketCap API Configuration
# Get your API key at: https://coinmarketcap.com/api/
# Leave blank to disable upstream calls; test fixtures pending Phase 2.
CMC_API_KEY=

# Upstream Request Safeguards (Basic Plan Protection)
# Application rate limit default: 25 req/min (maximum safety ceiling: 50 req/min).
# NOTE: The 50 req/min ceiling reflects the user's currently reported CMC Basic account limit.
# It is an account-specific safeguard, not a universal CoinMarketCap limit.
CMC_RATE_LIMIT_PER_MINUTE=25

# Upstream Request Timeout in milliseconds (bounds: 1000-30000 ms, default: 10000 ms)
CMC_REQUEST_TIMEOUT_MS=10000

# Configurable monthly upstream request budget (bounds: 1-100000, default: 10000).
# NOTE: This is an application-level soft cap on outgoing HTTP requests to CMC.
# It does NOT guarantee a specific CMC credit allowance.
CMC_MONTHLY_REQUEST_BUDGET=10000

# Cache TTL Configuration (in seconds)
# Protects credit budget by serving cached responses for repeated queries
CACHE_TTL_GLOBAL_METRICS_SEC=120
CACHE_TTL_LISTINGS_SEC=60
CACHE_TTL_QUOTES_SEC=30

# Local Snapshot Buffer Policy
# Max snapshot records retained per tracked asset in memory (circular buffer)
SNAPSHOT_MAX_OBSERVATIONS_PER_ASSET=120
# Maximum age before old snapshot records are evicted (in hours)
SNAPSHOT_MAX_AGE_HOURS=24
# NOTE on snapshot capacity:
# At a standard sampling frequency of 1 observation per minute, 120 observations
# represents at most 120 minutes (2 hours) of effective continuous intraday history.

# AI Explanation Service (Provider-Independent OpenAI-Compatible Endpoint)
# Supported providers: OpenAI, Groq, Ollama, OpenRouter, LocalAI, etc.
# Leave AI_API_KEY blank to operate in deterministic-only mode (all forensics work without AI).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI request timeout in milliseconds (bounds: 1000-60000 ms, default: 15000 ms)
AI_TIMEOUT_MS=15000
